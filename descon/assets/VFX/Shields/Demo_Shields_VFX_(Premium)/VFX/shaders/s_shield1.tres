code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, fog_disabled;

uniform float Gradient_Line : hint_range(0, 1) = 0;
uniform float Line_Baias = 0.01999999955297;
uniform vec2 Disolver_Scale = vec2(1.000000, 1.000000);
uniform sampler2D Disolver_Noise_Line : source_color, filter_linear, repeat_enable;
uniform float Line_Distortion_Divider = 5;
uniform sampler2D Gradient_Disappear : source_color, filter_linear, repeat_disable;
uniform sampler2D Line_Gradient : source_color, filter_linear, repeat_disable;
uniform vec2 Details_Scale = vec2(1.000000, 1.000000);
uniform vec2 Velocity = vec2(0.000000, 0.000000);
uniform sampler2D Normal_Distortion_Texture : hint_normal, filter_linear, repeat_enable;
uniform float RefStrenght;
uniform sampler2D Texture_Screen : source_color, filter_linear, hint_screen_texture;
uniform vec2 Overlay_Scale = vec2(1.000000, 1.000000);
uniform vec2 Overlay_Velocity = vec2(0.000000, 0.000000);
uniform sampler2D Overlay_Texture : source_color, hint_default_black, filter_linear;
uniform float Overlay_Power = 2;
uniform float Color_Details = 1;
uniform float Proximity_light = 0.5;
uniform sampler2D depth_tex_frg_31 : hint_depth_texture;
uniform float Proximity_Power = 0.5;
uniform bool Fresnel_invert;
uniform float fresnel_power = 0.68300002813339;
uniform float darkness = 0;
uniform sampler2D Gradient_1D_Color : source_color, filter_linear;



void fragment() {
// FloatParameter:56
	float n_out56p0 = Gradient_Line;


// FloatParameter:61
	float n_out61p0 = Line_Baias;


// FloatOp:59
	float n_out59p0 = n_out56p0 - n_out61p0;


// Input:78
	vec2 n_out78p0 = UV;


// Vector2Parameter:83
	vec2 n_out83p0 = Disolver_Scale;


// UVFunc:82
	vec2 n_in82p2 = vec2(0.00000, 0.00000);
	vec2 n_out82p0 = (UV - n_in82p2) * n_out83p0 + n_in82p2;


	vec4 n_out77p0;
// Texture2D:77
	n_out77p0 = texture(Disolver_Noise_Line, n_out82p0);
	float n_out77p1 = n_out77p0.r;


// FloatParameter:91
	float n_out91p0 = Line_Distortion_Divider;


// FloatOp:80
	float n_out80p0 = n_out77p1 / n_out91p0;


// VectorOp:79
	vec2 n_out79p0 = n_out78p0 + vec2(n_out80p0);


	vec4 n_out86p0;
// Texture2D:86
	n_out86p0 = texture(Gradient_Disappear, n_out79p0);
	float n_out86p1 = n_out86p0.r;


// SmoothStep:84
	float n_in84p1 = 0.80000;
	float n_out84p0 = smoothstep(n_out59p0, n_in84p1, n_out86p1);


	vec4 n_out90p0;
// Texture2D:90
	n_out90p0 = texture(Line_Gradient, vec2(n_out84p0));


// Input:4
	vec2 n_out4p0 = SCREEN_UV;


// Vector2Parameter:10
	vec2 n_out10p0 = Details_Scale;


// UVFunc:9
	vec2 n_in9p2 = vec2(0.00000, 0.00000);
	vec2 n_out9p0 = (UV - n_in9p2) * n_out10p0 + n_in9p2;


// Vector2Parameter:27
	vec2 n_out27p0 = Velocity;


// Input:29
	float n_out29p0 = TIME;


// VectorOp:28
	vec2 n_out28p0 = n_out27p0 * vec2(n_out29p0);


// UVFunc:26
	vec2 n_in26p1 = vec2(1.00000, 1.00000);
	vec2 n_out26p0 = n_out28p0 * n_in26p1 + n_out9p0;


	vec4 n_out21p0;
// Texture2D:21
	n_out21p0 = texture(Normal_Distortion_Texture, n_out26p0);
	float n_out21p1 = n_out21p0.r;
	float n_out21p2 = n_out21p0.g;


// VectorCompose:17
	vec2 n_out17p0 = vec2(n_out21p1, n_out21p2);


// MultiplyAdd:8
	vec2 n_in8p1 = vec2(2.00000, 2.00000);
	vec2 n_in8p2 = vec2(-1.00000, -1.00000);
	vec2 n_out8p0 = fma(n_out17p0, n_in8p1, n_in8p2);


// FloatParameter:7
	float n_out7p0 = RefStrenght;


// VectorOp:6
	vec2 n_out6p0 = n_out8p0 * vec2(n_out7p0);


// VectorOp:5
	vec2 n_out5p0 = n_out4p0 - n_out6p0;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture_Screen, n_out5p0);


// Input:50
	vec2 n_out50p0 = UV;


// Vector2Parameter:43
	vec2 n_out43p0 = Overlay_Scale;


// UVFunc:42
	vec2 n_in42p2 = vec2(0.00000, 0.00000);
	vec2 n_out42p0 = (n_out50p0 - n_in42p2) * n_out43p0 + n_in42p2;


// Vector2Parameter:44
	vec2 n_out44p0 = Overlay_Velocity;


// Input:47
	float n_out47p0 = TIME;


// VectorOp:45
	vec2 n_out45p0 = n_out44p0 * vec2(n_out47p0);


// UVFunc:46
	vec2 n_in46p1 = vec2(1.00000, 1.00000);
	vec2 n_out46p0 = n_out45p0 * n_in46p1 + n_out42p0;


	vec4 n_out41p0;
// Texture2D:41
	n_out41p0 = texture(Overlay_Texture, n_out46p0);
	float n_out41p1 = n_out41p0.r;


// FloatParameter:49
	float n_out49p0 = Overlay_Power;


// FloatOp:48
	float n_out48p0 = pow(n_out41p1, n_out49p0);


// FloatParameter:24
	float n_out24p0 = Color_Details;


// FloatOp:23
	float n_out23p0 = pow(n_out21p2, n_out24p0);


// FloatParameter:34
	float n_out34p0 = Proximity_light;


	float n_out31p0;
// ProximityFade:31
	{
		float __depth_tex = texture(depth_tex_frg_31, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out31p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_out34p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatParameter:36
	float n_out36p0 = Proximity_Power;


// FloatOp:35
	float n_out35p0 = pow(n_out31p0, n_out36p0);


// FloatFunc:33
	float n_out33p0 = 1.0 - n_out35p0;


// BooleanParameter:19
	bool n_out19p0 = Fresnel_invert;


// FloatParameter:14
	float n_out14p0 = fresnel_power;


// Fresnel:11
	float n_out11p0 = n_out19p0 ? (pow(clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out14p0)) : (pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out14p0));


// FloatOp:32
	float n_out32p0 = n_out33p0 + n_out11p0;


// FloatOp:22
	float n_out22p0 = n_out23p0 * n_out32p0;


// FloatOp:39
	float n_out39p0 = n_out48p0 + n_out22p0;


// Clamp:25
	float n_in25p1 = 0.00000;
	float n_in25p2 = 1.00000;
	float n_out25p0 = clamp(n_out39p0, n_in25p1, n_in25p2);


// FloatParameter:15
	float n_out15p0 = darkness;


// FloatOp:13
	float n_out13p0 = n_out25p0 - n_out15p0;


	vec4 n_out38p0;
// Texture2D:38
	n_out38p0 = texture(Gradient_1D_Color, vec2(n_out13p0));


// VectorOp:12
	vec3 n_out12p0 = vec3(n_out3p0.xyz) + vec3(n_out38p0.xyz);


// VectorOp:63
	vec3 n_out63p0 = vec3(n_out90p0.xyz) + n_out12p0;


// FloatConstant:62
	float n_out62p0 = 0.000000;


// Step:57
	float n_out57p0 = step(n_out56p0, n_out86p1);


// Output:0
	ALBEDO = n_out63p0;
	ALPHA = n_out62p0;
	ALPHA_SCISSOR_THRESHOLD = n_out57p0;


}
